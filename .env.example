# Public configuration (still consumed server-side only in this app)
NEXT_PUBLIC_APP_NAME="Vienna Job Desk"
APP_URL="http://localhost:3000"

# Store sensitive values in Vercel Sensitive Environment Variables.
# In local .env files, escape each dollar sign of the hash: scrypt\$...
ADMIN_PASSWORD_HASH="scrypt$..."
SESSION_SIGNING_KEY="generate-at-least-32-random-bytes"
AUTOMATION_SHARED_SECRET="generate-at-least-32-random-bytes"

SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."

DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_FAST_MODEL="deepseek-v4-flash"
DEEPSEEK_QUALITY_MODEL="deepseek-v4-pro"

GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_TOKEN_ENCRYPTION_KEY="base64-encoded-32-byte-key"
GMAIL_OWNER_EMAIL=""

# Optional: comma-separated ATS board identifiers.
GREENHOUSE_BOARDS=""
LEVER_SITES=""
ASHBY_BOARDS=""
